{
  "name": "motion-dna-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22.13.0", "pnpm": "11.21.0" },
  "scripts": {
    "setup:analyzer": "docker build -t motion-dna-analyzer:1 workers/analyzer",
    "setup:api": "uv sync --directory apps/api --frozen --all-groups",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @motion-dna/web dev",
    "dev:api": "uv run --directory apps/api python -m motion_dna_api",
    "dev:worker": "uv run --directory apps/api python -m motion_dna_api.renders.worker",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "db:logs": "docker compose --env-file .env -f infra/compose.yaml logs -f postgres",
    "db:purge-deleted": "uv run --directory apps/api python -m motion_dna_api.purge",
    "db:native:up": "node scripts/native-postgres.mjs up",
    "db:native:down": "node scripts/native-postgres.mjs down",
    "motion:bundle": "pnpm --filter @motion-dna/motion-engine build",
    "motion:render": "pnpm --filter @motion-dna/motion-engine render",
    "test": "pnpm --filter @motion-dna/motion-engine test && pnpm test:shared && pnpm --filter @motion-dna/web test && pnpm test:api",
    "test:shared": "node --import tsx --test tests/contracts.test.ts",
    "test:analyzer": "DNA_BROWSER_TESTS=1 uv run --directory apps/api pytest tests/test_dna_capture.py",
    "test:api": "uv run --directory apps/api pytest",
    "test:video:e2e": "VIDEO_RENDER_TESTS=1 playwright test tests/e2e/video-generation.spec.ts",
    "test:dna:e2e": "DNA_LIVE_TESTS=1 playwright test tests/e2e/dna-analysis.spec.ts",
    "test:e2e": "playwright test",
    "lint": "pnpm lint:shared && pnpm --filter @motion-dna/web lint && pnpm lint:api",
    "lint:shared": "eslint packages scripts tests workers/analyzer/extract.js playwright.config.ts --max-warnings 0",
    "lint:api": "uv run --directory apps/api ruff check --config pyproject.toml . ../../workers/analyzer && uv run --directory apps/api ruff format --config pyproject.toml --check . ../../workers/analyzer",
    "typecheck": "pnpm -r --if-present run typecheck && tsc --project tsconfig.json --noEmit",
    "build": "pnpm -r --if-present run build && pnpm build:api",
    "build:api": "uv build --directory apps/api --out-dir dist",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.19.7",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}

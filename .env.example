# Local development only. No paid AI service or API key is required.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Server-side only; never expose a database URL or secret through NEXT_PUBLIC_*.
API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Disposable local credentials. Use separate credentials outside development.
POSTGRES_USER=motiondna
POSTGRES_PASSWORD=motiondna_local
POSTGRES_DB=motiondna
POSTGRES_PORT=5432
DATABASE_URL=postgresql://motiondna:motiondna_local@127.0.0.1:5432/motiondna

# Disposable browser image, built with pnpm setup:analyzer. Docker must be running.
DNA_BROWSER_IMAGE=motion-dna-analyzer:1

# Optional AI Director. Default runs deterministic grounded storyboards without an LLM.
DIRECTOR_PROVIDER=deterministic
DIRECTOR_MODEL=qwen2.5:7b
DIRECTOR_URL=http://127.0.0.1:11434/api/chat
# Optional generic API gateway credential; never sent to the frontend.
DIRECTOR_API_TOKEN=

# Trusted-development-only static inspection of a local directory through the CLI.
SOURCE_LOCAL_MODE=0
